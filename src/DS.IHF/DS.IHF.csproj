<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>DS.IHF</RootNamespace>
    <AssemblyName>DS.IHF</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon />
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Authors>Hausärztinnen- und Hausärzteverband</Authors>
    <Company>Hausärztinnen- und Hausärzteverband</Company>
    <Product>DS-IHF Serienbrief-Upload</Product>
    <Description>DocuSign Serienbriefe automatisch hochladen</Description>
    <Copyright>© 2026 Hausärztinnen- und Hausärzteverband</Copyright>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.1.1" />
  </ItemGroup>

  <ItemGroup>
    <None Update="config\settings.template.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
