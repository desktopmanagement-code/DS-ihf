<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>DS.IHF</RootNamespace>
    <AssemblyName>DS.IHF</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>DSIHF.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Authors>Aequitas-Software für Hausärztinnen- und Hausärzteverband (Tobias Paul)</Authors>
    <Company>Aequitas-Software für Hausärztinnen- und Hausärzteverband (Tobias Paul)</Company>
    <Product>DS-IHF Serienbrief-Versand</Product>
    <Description>DocuSign Serienbriefe automatisch hochladen</Description>
    <Copyright>© 2026 Hausärztinnen- und Hausärzteverband</Copyright>
    <Version>1.1.0717</Version>
    <PackageId>DS-Versand</PackageId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.1.1" />
  </ItemGroup>

  <ItemGroup>
    <None Update="config\settings.template.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
