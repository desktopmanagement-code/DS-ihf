<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <Package Name="DS-IHF DocuSign Serienbrief-Upload"
           Manufacturer="Hausärztinnen- und Hausärzteverband"
           Version="1.0.0.0"
           UpgradeCode="B7C3D4E5-F6A7-8901-BCDE-F12345678901"
           Scope="perUser">

    <!-- Neuere Version deinstalliert alte automatisch -->
    <MajorUpgrade DowngradeErrorMessage="Eine neuere Version ist bereits installiert." />

    <!-- .NET 8 Runtime Voraussetzung prüfen -->
    <Launch Condition="Installed OR NETFRAMEWORK80PLUS"
            Message="Bitte installieren Sie zuerst .NET 8 Desktop Runtime (https://dotnet.microsoft.com/download/dotnet/8.0)." />

    <Property Id="NETFRAMEWORK80PLUS">
      <RegistrySearch Id="NetFx80Plus"
                      Root="HKLM"
                      Key="SOFTWARE\dotnet\Setup\InstalledVersions\x64\sharedfx\Microsoft.NETCore.App"
                      Name="8.0.0"
                      Type="raw" />
    </Property>

    <!-- Installationsverzeichnis: %LOCALAPPDATA%\DS-IHF (kein Admin nötig) -->
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="INSTALLFOLDER" Name="DS-IHF" />
    </StandardDirectory>

    <!-- Startmenü -->
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="DS-IHF" />
    </StandardDirectory>

    <ComponentGroup Id="ProductComponents" Directory="INSTALLFOLDER">

      <!-- Hauptdateien -->
      <Component Id="MainExecutable">
        <File Id="DS.IHF.exe"
              Source="..\src\DS.IHF\bin\Release\net8.0-windows\DS.IHF.exe"
              KeyPath="yes" />
      </Component>

      <Component Id="MainDll">
        <File Source="..\src\DS.IHF\bin\Release\net8.0-windows\DS.IHF.dll" />
      </Component>

      <Component Id="DepsDll">
        <File Source="..\src\DS.IHF\bin\Release\net8.0-windows\DS.IHF.deps.json" />
      </Component>

      <Component Id="RuntimeConfig">
        <File Source="..\src\DS.IHF\bin\Release\net8.0-windows\DS.IHF.runtimeconfig.json" />
      </Component>

      <Component Id="OpenXmlDll">
        <File Source="..\src\DS.IHF\bin\Release\net8.0-windows\DocumentFormat.OpenXml.dll" />
      </Component>

      <Component Id="OpenXmlFrameworkDll">
        <File Source="..\src\DS.IHF\bin\Release\net8.0-windows\DocumentFormat.OpenXml.Framework.dll" />
      </Component>

      <Component Id="PackagingDll">
        <File Source="..\src\DS.IHF\bin\Release\net8.0-windows\System.IO.Packaging.dll" />
      </Component>

      <!-- Startmenü-Shortcut -->
      <Component Id="ApplicationShortcut" Directory="ApplicationProgramsFolder">
        <Shortcut Id="AppStartMenuShortcut"
                  Name="DS-IHF Serienbrief-Upload"
                  Description="DocuSign Serienbriefe hochladen"
                  Target="[INSTALLFOLDER]DS.IHF.exe"
                  WorkingDirectory="INSTALLFOLDER" />
        <Shortcut Id="AppStartMenuShortcutDemo"
                  Name="DS-IHF Serienbrief-Upload (Demo)"
                  Description="DocuSign Serienbriefe hochladen - Demoumgebung"
                  Target="[INSTALLFOLDER]DS.IHF.exe"
                  Arguments="/Demo"
                  WorkingDirectory="INSTALLFOLDER" />
        <RemoveFolder Id="CleanupStartMenu" Directory="ApplicationProgramsFolder" On="uninstall" />
        <RegistryValue Root="HKCU"
                       Key="Software\DS-IHF"
                       Name="installed"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>

    </ComponentGroup>

    <Feature Id="ProductFeature" Title="DS-IHF" Level="1">
      <ComponentGroupRef Id="ProductComponents" />
    </Feature>

    <!-- Einfaches Installations-UI -->
    <ui:WixUI Id="WixUI_Minimal" />

  </Package>
</Wix>
